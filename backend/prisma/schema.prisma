generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Razones Sociales (BUK multi-empresa)
// ─────────────────────────────────────────────

enum LegalEntity {
  COMUNICACIONES_SURMEDIA
  SURMEDIA_CONSULTORIA
}

// ─────────────────────────────────────────────
// Auth & Usuarios
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  RRHH_MANAGER
  RRHH_ANALYST
  MANAGER
  EMPLOYEE
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  role         UserRole  @default(EMPLOYEE)
  avatarUrl    String?
  googleId           String?   @unique
  microsoftId        String?   @unique
  passwordHash       String?
  googleRefreshToken String?
  employee     Employee? @relation(fields: [employeeId], references: [id])
  employeeId   String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

// ─────────────────────────────────────────────
// Estructura Organizacional
// ─────────────────────────────────────────────

model Department {
  id        String      @id @default(uuid())
  name      String
  code      String      @unique
  parent    Department? @relation("DeptHierarchy", fields: [parentId], references: [id])
  parentId  String?
  children  Department[] @relation("DeptHierarchy")
  positions Position[]
  employees Employee[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("departments")
}

model Position {
  id           String     @id @default(uuid())
  title        String
  level        String?
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String
  employees    Employee[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("positions")
}

// ─────────────────────────────────────────────
// Colaboradores
// ─────────────────────────────────────────────

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  DUPLICATE
}

enum ContractType {
  INDEFINIDO
  PLAZO_FIJO
  HONORARIOS
  PRACTICA
}

// ─────────────────────────────────────────────
// Centros de Trabajo
// ─────────────────────────────────────────────

enum CostType {
  DIRECTO
  INDIRECTO
}

model WorkCenter {
  id          String               @id @default(uuid())
  name        String               @unique
  costType    CostType             @default(DIRECTO)
  presupuesto Float?
  ubicacion   String?
  assignments    EmployeeWorkCenter[]
  ingresos       WorkCenterIngreso[]
  proveedores    SmartProveedor[]
  smartDocuments SmartDocument[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("work_centers")
}

model WorkCenterIngreso {
  id           String     @id @default(uuid())
  workCenter   WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Cascade)
  workCenterId String
  name         String
  amount       Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("work_center_ingresos")
}

model EmployeeWorkCenter {
  id           String      @id @default(uuid())
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId   String
  workCenter   WorkCenter  @relation(fields: [workCenterId], references: [id], onDelete: Cascade)
  workCenterId String
  legalEntity  LegalEntity
  // Período de asignación (mes/año). endYear+endMonth null = vigente
  startYear    Int         @default(2000)
  startMonth   Int         @default(1)
  endYear      Int?
  endMonth     Int?
  createdAt    DateTime    @default(now())

  @@map("employee_work_centers")
}

model Employee {
  id           String         @id @default(uuid())
  rut          String         @unique
  firstName    String
  lastName     String
  email        String         @unique
  phone        String?
  birthDate    DateTime?
  address      String?
  nationality  String?        @default("Chilena")
  gender       String?

  position     Position?      @relation(fields: [positionId], references: [id])
  positionId   String?
  department   Department?    @relation(fields: [departmentId], references: [id])
  departmentId String?
  manager      Employee?      @relation("ReportsTo", fields: [managerId], references: [id])
  managerId    String?
  reports      Employee[]     @relation("ReportsTo")
  status       EmployeeStatus @default(ACTIVE)
  startDate    DateTime
  endDate      DateTime?

  afp          String?
  isapre       String?
  previredCode String?

  // Campos extendidos desde BUK
  city           String?
  commune        String?
  personalEmail  String?
  workSchedule   String?
  supervisorName  String?
  supervisorTitle String?
  jobFamily      String?   // Familia de Cargo (role_family)
  jobTitle       String?   // Cargo directo (role.name)
  costCenter     String?   // Centro / proyecto (current_job.cost_center)
  exclusive      Boolean?  // Exclusividad laboral
  vinculo        String?   // Planta, Reemplazo, etc.
  reemplazaA     String?   // Nombre del colaborador que reemplaza (solo si vínculo=Reemplazo)
  segundoApellido     String?
  distribucionJornada String?
  banco               String?
  tipoCuenta          String?
  numeroCuenta        String?

  user           User?
  contracts      Contract[]
  leaves         Leave[]
  documents      Document[]
  payrollEntries      PayrollEntry[]
  onboardingProcesses OnboardingProcess[]
  workCenters    EmployeeWorkCenter[]
  vacationBalances VacationBalance[]

  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("employees")
}

// ─────────────────────────────────────────────
// Contratos
// ─────────────────────────────────────────────

model Contract {
  id           String       @id @default(uuid())
  employee     Employee     @relation(fields: [employeeId], references: [id])
  employeeId   String
  type         ContractType
  startDate    DateTime
  endDate      DateTime?
  salary       Int
  currency     String       @default("CLP")
  isActive     Boolean      @default(true)
  fileUrl      String?

  legalEntity  LegalEntity?
  bukEmployeeId Int?
  grossSalary  Int?

  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("contracts")
}

// ─────────────────────────────────────────────
// Vacaciones y Permisos
// ─────────────────────────────────────────────

enum LeaveType {
  VACACIONES
  PERMISO
  LICENCIA_MEDICA
  LICENCIA_MATERNIDAD
  LICENCIA_PATERNIDAD
  OTRO
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Leave {
  id          String      @id @default(uuid())
  employee    Employee    @relation(fields: [employeeId], references: [id])
  employeeId  String
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  days        Int
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("leaves")
}

// ─────────────────────────────────────────────
// Saldo de vacaciones (snapshot mensual BUK)
// ─────────────────────────────────────────────

model VacationBalance {
  id                   String      @id @default(uuid())
  employeeId           String
  employee             Employee    @relation(fields: [employeeId], references: [id])
  legalEntity          LegalEntity
  year                 Int
  month                Int

  saldoLegal           Float       @default(0)
  saldoProgresivas     Float       @default(0)
  saldoAdministrativos Float       @default(0)
  diasLicencias        Float       @default(0)
  vacacionesTomadas    Float       @default(0)

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@unique([employeeId, legalEntity, year, month])
  @@map("vacation_balances")
}

// ─────────────────────────────────────────────
// Documentos
// ─────────────────────────────────────────────

model Document {
  id          String   @id @default(uuid())
  employee    Employee @relation(fields: [employeeId], references: [id])
  employeeId  String
  name        String
  type        String
  fileUrl     String
  driveFileId String?
  uploadedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("documents")
}

// ─────────────────────────────────────────────
// Auditoría
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entity     String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// Sincronización BUK
// ─────────────────────────────────────────────

enum SyncStatus {
  RUNNING
  SUCCESS
  ERROR
}

// ─────────────────────────────────────────────
// Remuneraciones mensuales (desde BUK)
// ─────────────────────────────────────────────

model PayrollEntry {
  id             String      @id @default(uuid())
  employee       Employee    @relation(fields: [employeeId], references: [id])
  employeeId     String
  legalEntity    LegalEntity
  year           Int
  month          Int
  bukPayrollId   Int?
  grossSalary    Int         @default(0)
  liquidSalary   Int         @default(0)
  items          Json        @default("[]")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([employeeId, legalEntity, year, month])
  @@map("payroll_entries")
}

// ─────────────────────────────────────────────
// Onboarding
// ─────────────────────────────────────────────

enum OnboardingPeriod {
  PRE_INGRESO
  DIA_1
  SEMANA_1
  MES_1
  EVALUACION
}

enum OnboardingStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskAutomationType {
  MANUAL
  EMAIL
  CALENDAR
  BUK_CHECK
  EXTERNAL
  SHEET_VERIFY
}

enum AutomationStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

model OnboardingProcess {
  id                   String           @id @default(uuid())
  // Colaborador — RUT obligatorio, nombre libre
  collaboratorRut           String?
  collaboratorName          String
  collaboratorEmail         String?
  collaboratorPersonalEmail String?
  collaboratorPosition      String?
  collaboratorPhone         String?
  costCenter                String?
  legalEntity          LegalEntity?
  notes                String?
  collaboratorData     Json?        // Snapshot de variables del colaborador al crear el proceso
  // Vinculación opcional a Employee de BUK (se hace después o auto por RUT)
  employee             Employee?        @relation(fields: [employeeId], references: [id])
  employeeId           String?
  // Estado del proceso
  status               OnboardingStatus @default(IN_PROGRESS)
  startDate            DateTime
  expectedEndDate      DateTime
  completedAt          DateTime?
  tasks                OnboardingTask[]
  forms                OnboardingForm[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@map("onboarding_processes")
}

model OnboardingTask {
  id               String             @id @default(uuid())
  process          OnboardingProcess  @relation(fields: [processId], references: [id], onDelete: Cascade)
  processId        String
  templateId       String?            // ID del hito en la plantilla (para trazabilidad)
  period           OnboardingPeriod
  name             String
  tool             String?
  appliesWhen      String?
  sortOrder        Int                @default(0)
  // Automatización
  automationType   TaskAutomationType @default(MANUAL)
  automationConfig Json?              // Configuración específica (email template, calendar config, etc.)
  automationStatus AutomationStatus?
  automationResult Json?              // Resultado del último intento
  automatedAt      DateTime?
  // Completado
  completedAt      DateTime?
  completedBy      String?
  completedNote    String?
  // Sub-tareas (sólo para hitos de plazo; copiadas de la plantilla al crear el proceso)
  subTasks         Json               @default("[]")
  assignments      OnboardingTaskAssignment[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("onboarding_tasks")
}

// ─────────────────────────────────────────────
// Perfiles — roles en el ecosistema de onboarding
// ─────────────────────────────────────────────

model Profile {
  id        String        @id @default(uuid())
  name      String
  position  String
  email     String        @unique
  phone     String?
  notes     String?
  roles                    ProfileRole[]
  taskAssignments          OnboardingTaskAssignment[]
  templateTasksResponsable OnboardingTemplateTask[]    @relation("TemplateTaskResponsable")
  subTasksResponsable      OnboardingTemplateSubTask[] @relation("SubTaskResponsable")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("profiles")
}

model OnboardingTaskAssignment {
  id        String         @id @default(uuid())
  task      OnboardingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  roleType  String         // RESPONSABLE_HITO | COPIA_CORREOS | ENVIA_CORREOS | RECIBE_CORREOS | PREPARA_ADM_FISICA
  createdAt DateTime       @default(now())

  @@unique([taskId, profileId, roleType])
  @@map("onboarding_task_assignments")
}

model ProfileRole {
  id        String  @id @default(uuid())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  area      String  // BUK | SMART | ADMINISTRACION | ACREDITACION | INGRESANTE | JEFATURA | MENTORIA | CHECKPOINTS | GENERAL
  roleType  String  // ENVIA_CORREOS | RECIBE_CORREOS | COPIA_CORREOS | PREPARA_ADM_FISICA | RESPONSABLE_HITO

  @@map("profile_roles")
}

// ─────────────────────────────────────────────
// Onboarding: Plantilla de hitos (editable)
// ─────────────────────────────────────────────

model OnboardingTemplateTask {
  id               String             @id @default(uuid())
  key              String             @unique
  period           OnboardingPeriod
  name             String
  tool             String?
  automationType   TaskAutomationType @default(MANUAL)
  automationConfig Json?
  appliesWhen      String?
  sortOrder        Int                @default(0)
  isActive         Boolean            @default(true)
  // Nuevos campos para gestión de hitos
  taskType              String   @default("PLAZO")  // FECHA_ESPECIFICA | PLAZO
  responsableProfileId  String?
  responsable           Profile? @relation("TemplateTaskResponsable", fields: [responsableProfileId], references: [id], onDelete: SetNull)
  appliesTo             Json     @default("[]")     // string[] de jobTitles; vacío = Todos
  subTasks              OnboardingTemplateSubTask[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("onboarding_template_tasks")
}

model OnboardingTemplateSubTask {
  id                   String                 @id @default(uuid())
  templateTask         OnboardingTemplateTask @relation(fields: [templateTaskId], references: [id], onDelete: Cascade)
  templateTaskId       String
  name                 String
  responsableProfileId String?
  responsable          Profile?               @relation("SubTaskResponsable", fields: [responsableProfileId], references: [id], onDelete: SetNull)
  tool                 String?
  plantilla            String?
  sortOrder            Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@map("onboarding_template_subtasks")
}

// ─────────────────────────────────────────────
// Sheets de onboarding (repositorio global)
// ─────────────────────────────────────────────

model OnboardingSheetTemplate {
  id             String   @id @default(uuid())
  key            String   @unique
  name           String
  url            String
  rutColumn      String   @default("RUT")
  columnMappings Json     @default("{}")
  sheetName      String?
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("onboarding_sheet_templates")
}

// ─────────────────────────────────────────────
// Templates de email y log de envíos
// ─────────────────────────────────────────────

model EmailTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  subject   String
  bodyHtml  String
  fromEmail String?
  toEmails  Json     @default("[]")
  ccEmails  Json     @default("[]")
  variables Json     @default("[]")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

// ─────────────────────────────────────────────
// Documentos de onboarding (Word con variables)
// ─────────────────────────────────────────────

model OnboardingDocument {
  id            String                       @id @default(uuid())
  name          String
  fileName      String
  filePath      String
  description   String?
  isActive      Boolean                      @default(true)
  templateLinks OnboardingDocumentTemplate[]
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@map("onboarding_documents")
}

model OnboardingDocumentTemplate {
  id          String             @id @default(uuid())
  document    OnboardingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId  String
  templateKey String
  sendAs      String             @default("WORD")
  createdAt   DateTime           @default(now())

  @@unique([documentId, templateKey])
  @@map("onboarding_document_templates")
}

model EmailLog {
  id          String   @id @default(uuid())
  processId   String?
  taskId      String?
  toEmail     String
  subject     String
  status      String
  error       String?
  templateKey String?
  sentAt      DateTime @default(now())

  @@map("email_logs")
}

// ─────────────────────────────────────────────
// Reglas de correo para eventos de Calendario
// ─────────────────────────────────────────────

enum CalendarEmailEventType {
  CUMPLEANOS
  ANIVERSARIO_LABORAL
  RECONOCIMIENTO
}

model CalendarEmailRule {
  id              String                 @id @default(uuid())
  name            String
  eventType       CalendarEmailEventType
  fromProfileId   String?                // Perfil remitente ("De:")
  subject         String
  bodyHtml        String                 @db.Text
  daysBeforeEvent Int                    @default(0)
  sendTime        String                 @default("09:00") // HH:MM hora Chile
  toColaborador   Boolean                @default(true)
  toDirectEmails  Json                   @default("[]")    // Para: emails directos adicionales
  ccProfileIds    Json                   @default("[]")    // CC: perfiles del sistema
  ccCustomEmails  Json                   @default("[]")    // CC: emails adicionales
  isActive        Boolean                @default(false)   // true = envío automático por SMTP
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@map("calendar_email_rules")
}

// ─────────────────────────────────────────────
// Formularios de onboarding
// ─────────────────────────────────────────────

model OnboardingForm {
  id        String            @id @default(uuid())
  processId String
  process   OnboardingProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  title     String
  fields    Json              @default("[]")
  token     String            @unique @default(uuid())
  isActive  Boolean           @default(true)
  responses FormResponse[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("onboarding_forms")
}

model FormResponse {
  id              String         @id @default(uuid())
  form            OnboardingForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId          String
  respondentName  String?
  respondentEmail String?
  data            Json           @default("{}")
  submittedAt     DateTime       @default(now())

  @@map("form_responses")
}

model SyncLog {
  id               String      @id @default(uuid())
  source           String
  legalEntity      LegalEntity
  status           SyncStatus  @default(RUNNING)
  startedAt        DateTime    @default(now())
  completedAt      DateTime?
  employeesTotal   Int         @default(0)
  employeesCreated Int         @default(0)
  employeesUpdated Int         @default(0)
  contractsUpserted Int        @default(0)
  duplicatesSkipped Int        @default(0)
  errorMessage     String?
  errorDetails     Json?

  @@map("sync_logs")
}

// ─────────────────────────────────────────────
// Presupuesto DPDO
// ─────────────────────────────────────────────

model BudgetCategory {
  id        String       @id @default(uuid())
  section   String       @default("PARTIDAS") // PARTIDAS | BENEFICIOS
  name      String
  sortOrder Int          @default(0)
  items     BudgetItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("budget_categories")
}

model BudgetItem {
  id           String         @id @default(uuid())
  category     BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId   String
  name         String
  annualAmount Int            @default(0)
  spentAmount  Int            @default(0)
  sortOrder    Int            @default(0)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("budget_items")
}

// ─────────────────────────────────────────────
// Smart — Honorarios y Compras
// ─────────────────────────────────────────────

enum SmartDocCategory {
  HONORARIO
  COMPRA
}

model SmartProveedor {
  id            String          @id @default(uuid())
  rut           String          @unique
  razonSocial   String
  notes         String?
  clasificacion String?
  area          String?
  categoria     String?
  workCenter    WorkCenter?     @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  workCenterId  String?
  documents     SmartDocument[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("smart_proveedores")
}

model SmartDocument {
  id                        String           @id @default(uuid())
  smartId                   String           @unique
  category                  SmartDocCategory
  proveedor                 SmartProveedor   @relation(fields: [proveedorId], references: [id])
  proveedorId               String
  workCenter                WorkCenter?      @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  workCenterId              String?
  legalEntity               LegalEntity
  documento                 String
  codigoTributario          String?
  folio                     String?
  recibido                  String?
  vigente                   Boolean          @default(true)
  fechaEmision              DateTime?
  fechaVencimiento          DateTime?
  fechaPago                 DateTime?
  clasificacion             String?
  montoExento               Int              @default(0)
  montoAfecto               Int              @default(0)
  montoNeto                 Int              @default(0)
  retencion                 Int?
  iva                       Int?
  montoBruto                Int              @default(0)
  ivaFueraDePlazo           Int              @default(0)
  montoTotal                Int              @default(0)
  remanente                 Int              @default(0)
  pagado                    Boolean          @default(false)
  folioReferencia           String?
  codigoReferencia          String?
  codigoUnico               String?
  periodoTributario         String?
  periodoTributarioOriginal String?
  glosa                     String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  @@map("smart_documents")
}
