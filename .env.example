# ================================================
# GDP Surmedia — Variables de Entorno
# Copiar a backend/.env y completar los valores
# NUNCA commitear el archivo .env
# ================================================

# Aplicación
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000

# Base de Datos (Supabase)
# DATABASE_URL: usar la URL del connection pooler de Supabase (puerto 6543)
# DIRECT_URL:   usar la URL directa de Supabase (puerto 5432) — necesaria para migraciones
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].supabase.com:5432/postgres

# Autenticación / JWT
JWT_SECRET=change_this_to_a_random_secret_min_32_chars

# Google OAuth / Workspace
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
GOOGLE_DOMAIN=surmedia.cl

# Correo transaccional (para automatizaciones de onboarding)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rrhh@surmedia.cl
SMTP_PASSWORD=your_app_password
EMAIL_FROM="RRHH Surmedia <rrhh@surmedia.cl>"
